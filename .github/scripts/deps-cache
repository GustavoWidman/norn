#!/usr/bin/env bash
set -euo pipefail

cache="${RUNNER_TEMP:?missing runner temp directory}/norn-deps"

case "${1:-}" in
  locate)
    path=$(nix eval --raw .#default.cargoArtifacts.outPath)
    system=$(nix eval --raw --impure --expr builtins.currentSystem)
    hash=$(basename "$path")
    printf 'path=%s\nkey=norn-deps-%s-%s\n' "$path" "$system" "${hash%%-*}"
    ;;
  import)
    # GitHub hands main's cache entries to pull requests read-only, and only main's
    # release runs save one, so the unsigned import only ever sees main's builds
    nix copy --no-check-sigs --from "file://$cache" "${2:?missing store path}"
    ;;
  export)
    nix copy --to "file://$cache?compression=zstd" "${2:?missing store path}"
    du -sh "$cache"
    ;;
  *)
    printf 'usage: %s locate | import <path> | export <path>\n' "$0" >&2
    exit 64
    ;;
esac
